generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  username           String              @unique @db.Text
  nickname           String              @db.Text
  email              String              @db.Text
  password           String
  notReadyCharacters NotReadyCharacter[]
  readyCharacters    ReadyCharacter[]

  @@map("user")
}

model DungeonMaster {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique @db.Text
  nickname String @db.Text
  email    String @db.Text
  password String
  game     Game   @relation(fields: [gameId], references: [id])
  gameId   String @unique @map("game_id")

  @@map("dungeon_master")
}

model InactivePlayer {
  id       String                 @id @default(uuid()) @db.Uuid
  username String                 @unique @db.Text
  nickname String                 @db.Text
  email    String                 @db.Text
  password String
  games    InactivePlayerOnGame[]

  @@map("inactive_player")
}

model InactivePlayerOnGame {
  player   InactivePlayer @relation(fields: [playerId], references: [id])
  playerId String         @map("player_id")
  game     Game           @relation(fields: [gameId], references: [id])
  gameId   String         @map("game_id")

  @@id([playerId, gameId])
  @@map("inactive_player_on_game")
}

model Participant {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique @db.Text
  nickname String @db.Text
  email    String @db.Text
  password String

  @@map("participant")
}

model Game {
  id            String                 @id @default(uuid()) @db.Uuid
  name          String                 @db.Text
  description   String                 @db.Text
  dungeonMaster DungeonMaster?
  players       InactivePlayerOnGame[]

  @@map("game")
}

model Race {
  id                 String              @id @db.Text
  notReadyCharacters NotReadyCharacter[]
  readyCharacters    ReadyCharacter[]

  @@map("race")
}

model Class {
  id                 String              @id @db.Text
  notReadyCharacters NotReadyCharacter[]
  readyCharacters    ReadyCharacter[]

  @@map("class")
}

model NotReadyCharacter {
  id      String  @id @default(uuid()) @db.Uuid
  name    String? @db.Text
  race    Race?   @relation(fields: [raceId], references: [id])
  raceId  String? @map("race_id")
  class   Class?  @relation(fields: [classId], references: [id])
  classId String? @map("class_id") @db.Text
  user    User    @relation(fields: [userId], references: [id])
  userId  String  @map("user_id")

  @@map("not_ready_character")
}

model ReadyCharacter {
  id      String @id @default(uuid()) @db.Uuid
  name    String @db.Text
  race    Race   @relation(fields: [raceId], references: [id])
  raceId  String @map("race_id")
  user    User   @relation(fields: [userId], references: [id])
  userId  String @map("user_id")
  class   Class  @relation(fields: [classId], references: [id])
  classId String @map("class_id") @db.Text

  @@map("ready_character")
}
